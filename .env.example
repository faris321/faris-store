# ─── إعدادات السيرفر ───────────────────────────────────
PORT=3000

# ─── رقم الأونر (صاحب المتجر) ─────────────────────────
# سجّل دخولك بهذا الرقم لتحصل على رتبة أونر تلقائياً
# الصيغة المقبولة: 05xxxxxxxx أو +9665xxxxxxxx
OWNER_PHONE=05xxxxxxxxx

# ─── Twilio SMS (لإرسال رموز OTP) ─────────────────────
# سجّل مجاناً على https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
